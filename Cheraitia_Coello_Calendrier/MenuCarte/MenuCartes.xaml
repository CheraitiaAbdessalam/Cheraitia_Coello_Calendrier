<UserControl x:Class="Cheraitia_Coello_Calendrier.MenuCarte.MenuCartes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cheraitia_Coello_Calendrier.MenuCarte"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="#F4FCC2">
    <Grid>
        <!-- Définition des lignes -->
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- Image de fond qui occupe tout le Grid -->
        <Image Source="../Image/img1.png" Stretch="Fill" Grid.RowSpan="3"/>

        <!-- Ligne 0 : boutons répartis en 3 colonnes -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Carte du jour" Margin="5" Background="#FBC02D" />
            <Button Grid.Column="1" Content="Menu des cartes" Margin="5" Background="#FF5A5F"/>
            <Button Grid.Column="2" Content="Calendrier" Margin="5" Background="#00C49A" />
        </Grid>
        <Grid Grid.Row="1">
            <ListBox x:Name="CardsListBox"
         Background="Transparent"
         BorderThickness="0"
         ScrollViewer.HorizontalScrollBarVisibility="Auto"
         ScrollViewer.VerticalScrollBarVisibility="Disabled"
         >
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <!-- Reste de ton style et template -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#80FFFFFF" CornerRadius="8" Padding="10" Margin="5" BorderBrush="Gray" BorderThickness="1" Width="150" Height="200">
                            <StackPanel>
                                <Image Source="{Binding ImagePath}" Height="120" Stretch="Uniform"/>
                                <TextBlock Text="{Binding Titre}" FontSize="16" FontWeight="Bold" Foreground="Black" Margin="0,5,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
