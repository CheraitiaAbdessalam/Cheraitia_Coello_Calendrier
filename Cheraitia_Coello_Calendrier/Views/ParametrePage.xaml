<UserControl x:Class="Cheraitia_Coello_Calendrier.Views.ParametrePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="DarkRed">

    <!-- ====================== RESSOURCES ====================== -->
    <UserControl.Resources>

        <!-- STYLE : Interrupteur ToggleButton -->
        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <!-- Track -->
                            <Border x:Name="Track"
                                    CornerRadius="15"
                                    Background="#888"
                                    Width="60" Height="30"/>

                            <!-- Thumb -->
                            <Border x:Name="Thumb"
                                    Width="26" Height="26"
                                    CornerRadius="13"
                                    Background="White"
                                    Margin="2"
                                    HorizontalAlignment="Left"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Quand ON -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#00cc66"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ====================== CONTENU ====================== -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Colonne gauche : image -->
        <Grid Grid.Column="0">
            <Image Source="../Image/img2.png" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Width="200" Height="300" 
                   Stretch="Uniform" />
        </Grid>

        <!-- Colonne droite : formulaire -->
        <Grid Grid.Column="1" Margin="20" Background="#FFB91111">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Ligne 1 : Prénom -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="18" Margin="10">
                Prénom :
            </TextBlock>

            <TextBox Grid.Row="0" Grid.Column="1"
                     Width="200" Height="30"
                     FontSize="16"
                     Margin="10"
                     x:Name="PrenomTextBox" />

            <!-- Ligne 2 : Âge -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="18" Margin="10">
                Âge :
            </TextBlock>

            <TextBox Grid.Row="1" Grid.Column="1"
                     Width="200" Height="30"
                     FontSize="16"
                     Margin="10"
                     x:Name="AgeTextBox" />

            <!-- Ligne 3 : Son ON/OFF -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="18" Margin="10">
                Son :
            </TextBlock>

            <ToggleButton Grid.Row="2" Grid.Column="1"
                          Style="{StaticResource SwitchStyle}"
                          Margin="10"
                          x:Name="SoundToggleButton" />

        </Grid>
    </Grid>

</UserControl>
