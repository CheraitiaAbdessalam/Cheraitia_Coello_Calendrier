<Window x:Class="Cheraitia_Coello_Calendrier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cheraitia_Coello_Calendrier"
        xmlns:views="clr-namespace:Cheraitia_Coello_Calendrier.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid x:Name="Container" >

        <Grid.Background>
            <ImageBrush ImageSource="Image/img1.png" Stretch="Fill"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <!-- Ligne boutons -->
            <RowDefinition Height="8*"/>
            <!-- Ligne contenu -->
            
        </Grid.RowDefinitions>

        <!-- Ligne 1 : boutons -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Carte du jour" Margin="5" Background="#FBC02D" Click="CarteDuJour_Click" />
            <Button Grid.Column="1" Content="Menu des cartes" Margin="5" Background="#FF5A5F" Click="MenuDesCartes_Click"/>
            <Button Grid.Column="2" Content="Paramètre" Margin="5" Background="#00C49A" Click="Parametre_Click" />
        </Grid>

        <!-- Ligne 2 : contenu dynamique -->
        <Grid Grid.Row="1" x:Name="ContentArea">
            <!-- Ici on affiche le UserControl -->
        </Grid>
